<Window x:Class="UniversalConvert.Plugin.VlcVideo.VlcPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="UniversalConvert" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="300" MinWidth="480"
        Loaded="OnLoaded" Closed="OnClosed">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Margin="4,2,4,8"/>

        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" Background="#111111">
            <Grid Background="#111111">
                <vlc:VideoView x:Name="VideoHost" Background="Black"
                               PreviewMouseLeftButtonDown="OnVideoMouseLeftDown"/>
            </Grid>
        </Border>

        <Slider x:Name="ProgressSlider" Grid.Row="2" Minimum="0" Maximum="1" Value="0"
                Margin="4,10,4,0" VerticalAlignment="Center" IsEnabled="False"
                PreviewMouseDown="OnProgressPreviewMouseDown" PreviewMouseUp="OnProgressPreviewMouseUp"
                ValueChanged="OnProgressChanged"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,10,4,0">
            <Button x:Name="PlayPauseButton" Content="播放" Padding="14,4"
                    IsEnabled="False" Click="OnPlayPause" Margin="0,0,8,0"/>
            <Button Content="停止" Padding="14,4" Click="OnStop" Margin="0,0,16,0"/>
            <TextBlock x:Name="TimeText" VerticalAlignment="Center" Foreground="#666666" Margin="0,0,16,0"/>
            <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="1" Value="1"
                    VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
            <TextBlock x:Name="VolumeText" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="#666666" FontSize="12"/>
            <Button Content="关闭" Padding="16,4" Margin="24,0,0,0"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>