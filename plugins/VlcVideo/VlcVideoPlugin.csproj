<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>UniversalConvert.Plugin.VlcVideo</RootNamespace>
    <AssemblyName>UniversalConvert.Plugin.VlcVideo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core SDK 由 CI 从主仓库 Release 下载到 lib\ -->
    <Reference Include="UniversalConvert.Core">
      <HintPath>..\..\lib\UniversalConvert.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.*" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" GeneratePathProperty="true" />
  </ItemGroup>

</Project>
